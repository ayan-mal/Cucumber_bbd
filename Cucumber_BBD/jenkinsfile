
pipeline {
agent any


tools {
    jdk 'JDK21'
}

stages {

    stage('Checkout') {
        steps {
            git branch: 'main',
                url: 'https://github.com/ayan-mal/Cucumber_bbd/tree/main/Cucumber_BBD.git'
        }
    }

    stage('Build and Test') {
        steps {
            bat 'mvn clean test'
        }
    }

    stage('Publish Results') {
        steps {
            junit allowEmptyResults: true,
            testResults: '*/surefire-reports/.xml'
        }
    }
}

post {

    success {
        echo 'Build Successful'
    }

    failure {
        echo 'Build Failed'
    }

    always {
        echo 'Pipeline Execution Completed'
    }
}


}
